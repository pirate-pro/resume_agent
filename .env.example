APP_NAME=single-agent-runtime
DEBUG=false
DATA_DIR=./data

# General OpenAI-compatible settings
LLM_BASE_URL=http://199.199.199.60/v1
LLM_API_KEY=gpustack_e4c897fec9ec7236_df2b1445773485b4875fd5a9a66c1615
LLM_MODEL=qwen3-vl-32b-instruct
LLM_TIMEOUT_SECONDS=120
CHAT_STREAM_HEARTBEAT_INTERVAL_SECONDS=15
CHAT_STREAM_RUN_TIMEOUT_SECONDS=300

# Mid-term flush worker
MID_TERM_FLUSH_WORKER_ENABLED=true
MID_TERM_FLUSH_WORKER_POLL_INTERVAL_SECONDS=8
MID_TERM_FLUSH_WORKER_MAX_AGENTS_PER_TICK=24
MID_TERM_FLUSH_WORKER_MAX_JOBS_PER_AGENT=2
MID_TERM_FLUSH_MODEL_CONTEXT_WINDOW_TOKENS=32768
MID_TERM_FLUSH_INPUT_RATIO=0.35
MID_TERM_FLUSH_OUTPUT_RESERVE_TOKENS=1200
MID_TERM_FLUSH_PROMPT_OVERHEAD_TOKENS=900
MID_TERM_FLUSH_MAX_INPUT_TOKENS=5200

# Short-term context compaction
CONTEXT_COMPACTION_ENABLED=true
CONTEXT_COMPACTION_TRIGGER_EVENT_COUNT=60
CONTEXT_COMPACTION_TRIGGER_TOKEN_COUNT=12000
CONTEXT_COMPACTION_TRIGGER_CONTEXT_WINDOW_RATIO=0.45
CONTEXT_COMPACTION_MODEL_CONTEXT_WINDOW_TOKENS=32768
CONTEXT_COMPACTION_RETENTION_STRATEGY=event_count
CONTEXT_COMPACTION_RETAIN_EVENT_COUNT=32
CONTEXT_COMPACTION_RETAIN_TOKEN_COUNT=7000
CONTEXT_COMPACTION_RETAIN_CONTEXT_WINDOW_RATIO=0.25
CONTEXT_COMPACTION_MODEL_INPUT_RATIO=0.45
CONTEXT_COMPACTION_MODEL_OUTPUT_RESERVE_TOKENS=1600
CONTEXT_COMPACTION_PROMPT_OVERHEAD_TOKENS=900

# Alternative variable names (also supported)
VL_MODEL_API_URL=http://199.199.199.60/v1
